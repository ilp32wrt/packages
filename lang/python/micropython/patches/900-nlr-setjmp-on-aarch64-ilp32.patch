From: liviyifan <344781483+liviyifan@users.noreply.github.com>
Subject: py/nlr: use setjmp on AArch64 ILP32

nlraarch64.c saves the 64-bit x19-x30 and sp into nlr_buf_t, whose slots
are pointer-sized; on ILP32 they are 4 bytes and its size assertion fails.
Use the portable setjmp implementation there (as on other unlisted
architectures). The unix port already finds GC roots with setjmp on AArch64.

---
--- a/py/nlr.h
+++ b/py/nlr.h
@@ -75,7 +75,9 @@
         // so only save/restore those as an optimisation.
         #define MICROPY_NLR_NUM_REGS (MICROPY_NLR_NUM_REGS_ARM_THUMB_FP)
     #endif
-#elif defined(__aarch64__)
+#elif defined(__aarch64__) && !defined(__ILP32__)
+    // (AArch64 ILP32: nlraarch64.c stores 64-bit registers in pointer-sized
+    // slots; it uses the setjmp implementation below)
     #define MICROPY_NLR_AARCH64 (1)
     #define MICROPY_NLR_NUM_REGS (MICROPY_NLR_NUM_REGS_AARCH64)
 #elif defined(__xtensa__)
